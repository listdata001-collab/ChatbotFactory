# Database Configuration
# Local dev (PostgreSQL): postgresql://user:password@localhost/botfactory_db
# Neon (serverless):      postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost/botfactory_db

# Security
SESSION_SECRET=your-secret-key-here
TELEGRAM_WEBHOOK_SECRET=
ALLOW_LEGACY_TELEGRAM_WEBHOOKS=false
META_APP_SECRET=

# AI Services
GOOGLE_API_KEY=your-google-api-key
# Optional: override Gemini model (default: gemini-3.1-flash-lite)
# Other options: gemini-2.5-flash, gemini-2.5-pro, gemini-3.1-flash-lite-preview
GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Optional: Instagram & WhatsApp (if needed)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# Optional: Payment Gateways (if needed)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_ACCESS_TOKEN=
